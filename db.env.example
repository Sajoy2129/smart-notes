# Template for db.env, the database secret used by compose.yaml.
# Copy it (cp db.env.example db.env) and replace CHANGE_ME in BOTH lines with the
# same new password: letters and digits only, so it's safe inside the URL.
# Make one with: python3 -c "import secrets; print(secrets.token_hex(24))"
# db.env is in .gitignore and .dockerignore: never commit it.

# Read by the db container: the password PostgreSQL is created with.
POSTGRES_PASSWORD=CHANGE_ME

# Read by the app container: where the database is ("db" = the db service).
DATABASE_URL=postgresql://smart_notes:CHANGE_ME@db:5432/smart_notes
